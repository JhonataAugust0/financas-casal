# =============================================================
# Financas em Parceria — Environment Configuration
# =============================================================
# Copy this file to .env and fill in your values.

# Adapter selection: "sqlite" (default) or "supabase"
ADAPTER=sqlite

# Supabase credentials (required when ADAPTER=supabase)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key
